{
  "name": "kp-lab-manager-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "ci:check": "pnpm format:check && pnpm type-check && pnpm lint && vitest run && pnpm build",
    "ci:check:fix": "pnpm format && pnpm lint:fix && pnpm type-check && vitest run && pnpm build",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.1.0",
    "@marsidev/react-turnstile": "^1.5.2",
    "@portone/browser-sdk": "^0.1.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-devtools": "^1.166.3",
    "dayjs": "^1.11.19",
    "react": "^19.2.0",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.11"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "nanoid": ">=3.3.17",
      "picomatch": ">=4.0.4",
      "minimatch": "^10.2.4",
      "immutable": "^5.1.8",
      "seroval": "^1.5.3",
      "fast-uri": ">=3.1.5 <4.0.0",
      "undici": "^7.28.0",
      "js-yaml": ">=4.3.1 <5.0.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "@babel/core@<=7.29.0": ">=7.29.6 <8.0.0",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "core-js",
      "esbuild",
      "msw"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.1",
    "@tanstack/router-plugin": "^1.166.3",
    "@tanstack/router-vite-plugin": "^1.166.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "allure-commandline": "^2.38.1",
    "allure-vitest": "^3.6.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.4.0",
    "msw": "^2.12.12",
    "postcss": "^8.5.18",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.0"
  }
}
